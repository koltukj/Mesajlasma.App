        private ConversationSummaryDto? BuildConversationSummary(
            Conversation conversation,
            Guid currentUserId)
        {
            var otherUserId = conversation.ParticipantIds.FirstOrDefault(id =>
            id != currentUserId);
            var otherUser = _data.Users.FirstOrDefault(user => user.Id == otherUserId);
            if (otherUser == null)
            {
                return null;
            }
            var conversationMessages = _data.Messages
                .Where(message => message.ConversationId == conversation.Id)
                .ToList();

            var lastMessage = conversationMessages
                .OrderByDescending(message => message.SentAt)
                .FirstOrDefault();

            var unreadCount = conversationMessages.Count(message =>
            message.SenderId != currentUserId &&
            !message.ReadByUserIds.Contains(currentUserId));

            return new ConversationSummaryDto(
                conversation.Id,
                ToUserDto(otherUser),
                lastMessage is null ? null : ToMessageDto(lastMessage),
                unreadCount,
                lastMessage?.SentAt ?? conversation.CreateAt);
        }

        private MessageDto ToMessageDto(ChatMessage message)
        {
            var sender = _data.Users.FirstOrDefault(user => user.Id == message.SenderId);
            return new MessageDto(
                message.Id,
                message.ConversationId,
                message.SenderId,
                sender?.DisplayName ?? "Bilinmeyen kullanici",
                message.Content,
                message.AttachmentName,
                message.AttachmentUrl,
                message.SentAt,
                message.ReadByUserIds.Distinct().Count(),
                message.DeliveredToUserIds.Distinct().Count(),
                message.EditedAt is not null,
                message.IsDeleted);
        }

        private static UserDto ToUserDto(AppUser user)
        {
            return new UserDto(
                user.Id,
                user.DisplayName,
                user.Email,
                !user.IsInvisible && DateTime.UtcNow - user.LastSeenAt < TimeSpan.FromMinutes(5),
                user.LastSeenAt,
                user.ProfileImageUrl,
                user.StatusMessage);
        }

