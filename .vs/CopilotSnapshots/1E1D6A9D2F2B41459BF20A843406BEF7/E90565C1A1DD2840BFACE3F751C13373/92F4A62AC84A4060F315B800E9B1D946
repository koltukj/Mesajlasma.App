using MesajlasmaApp.Models;
using Microsoft.AspNetCore.Identity;
using System.Text.Json;
using static MesajlasmaApp.Models.ApiModels;
namespace MesajlasmaApp.Services
{
    //bu dosya kullanicilari kaydeder  gris yapacak kullaniciyi bulur parolalari guvenli sekilde saklar konusmalari ve mesahjalri yonetir  Verileri appdata/.data jason dosyasiona kaydeder ilk acilista demo kullanicilari olsuturuur

    public sealed class JsonDataStore
    {
        private readonly string _dataFilePath;
        private readonly PasswordHasher<AppUser> _passwordHasher;
        private readonly SemaphoreSlim _gate = new(1, 1);
        private readonly JsonSerializerOptions _jsonOptions = new(JsonSerializerDefaults.Web)
        {
            WriteIndented = true
        };
        private AppData _data = new();
        public JsonDataStore(
            IWebHostEnvironment enviroment,
            PasswordHasher<AppUser> passwordHasher)
        {
            _passwordHasher = passwordHasher;
            var datadirectory = Path.Combine(enviroment.ContentRootPath, "AppData");
            Directory.CreateDirectory(datadirectory);
            _dataFilePath = Path.Combine(datadirectory, "data.json");
        }

        public async Task<UserDto?> UpdateProfileImageAsync(Guid userId, string imageUrl)
        {
            await _gate.WaitAsync();
            try
            {
                var user = _data.Users.FirstOrDefault(item => item.Id == userId);
                if (user is null) return null;
                user.ProfileImageUrl = imageUrl;
                await SaveInternalAsync();
                return ToUserDto(user);
            }
            finally { _gate.Release(); }
        }

        public async Task<UserDto?> UpdateProfileAsync(Guid userId, string displayName, string statusMessage, bool isInvisible, string? profileImageUrl = null)
        {
            await _gate.WaitAsync();
            try
            {
                var user = _data.Users.FirstOrDefault(item => item.Id == userId);
                if (user is null || string.IsNullOrWhiteSpace(displayName)) return null;
                user.DisplayName = displayName.Trim();
                user.StatusMessage = statusMessage?.Trim() ?? string.Empty;
                user.IsInvisible = isInvisible;
                if (profileImageUrl is not null) user.ProfileImageUrl = profileImageUrl;
                await SaveInternalAsync();
                return ToUserDto(user);
            }
            finally { _gate.Release(); }
        }

        public async Task<MessageDto?> AddAttachmentMessageAsync(Guid conversationId, Guid senderId, string name, string url)
        {
            await _gate.WaitAsync();
            try
            {
                var conversation = _data.Conversations.FirstOrDefault(item => item.Id == conversationId && item.ParticipantIds.Contains(senderId));
                if (conversation is null) return null;
                var message = new ChatMessage
                {
                    ConversationId = conversationId,
                    SenderId = senderId,
                    Content = name,
                    AttachmentName = name,
                    AttachmentUrl = url,
                    SentAt = DateTime.UtcNow,
                    DeliveredToUserIds = conversation.ParticipantIds.ToList(),
                    ReadByUserIds = [senderId]
                };
                _data.Messages.Add(message);
                await SaveInternalAsync();
                return ToMessageDto(message);
            }
            finally { _gate.Release(); }
        }

        public async Task<IReadOnlyList<MessageDto>?> SearchMessagesAsync(Guid currentUserId, Guid conversationId, string query)
        {
            await _gate.WaitAsync();
            try
            {
                var conversation = _data.Conversations.FirstOrDefault(item =>
                    item.Id == conversationId && item.ParticipantIds.Contains(currentUserId));
                if (conversation is null) return null;

                return _data.Messages
                    .Where(message => message.ConversationId == conversationId &&
                                      !message.DeletedForUserIds.Contains(currentUserId) &&
                                      message.Content.Contains(query, StringComparison.OrdinalIgnoreCase))
                    .OrderBy(message => message.SentAt)
                    .Select(ToMessageDto)
                    .ToList();
            }
            finally { _gate.Release(); }
        }
        public async Task InitializeAsync()
        {
            await _gate.WaitAsync();
            try
            {
                if(File.Exists(_dataFilePath))
                {
                    try
                    {
                        await using var stream = File.OpenRead(_dataFilePath);
                        _data = await JsonSerializer.DeserializeAsync<AppData>(stream, _jsonOptions) ?? new AppData();
                    }
                    catch (Exception)
                    {
                        var backupPath = _dataFilePath + ".bozuk-" + DateTime.UtcNow.ToString("yyyyMMddHHmmss");
                        File.Copy(_dataFilePath, backupPath, overwrite: true);
                        _data = new AppData();
                    }
                }
                NormalizeData();
                if (_data.Users.Count == 0)
                {
                    SeedDemoData();
                    await SaveInternalAsync();
                }
            }
            finally
            {
                _gate.Release();
            }
        }

        public async Task<(AppUser? User, string? Error)> CreateUserAsync(string displayName, string email, string password)
        {
            displayName = displayName.Trim();
            email = NormalizeEmail(email);
            await _gate.WaitAsync();
            try
            {
                if (_data.Users.Any(user => string.Equals(user.Email, email, StringComparison.OrdinalIgnoreCase)))
                {
                    return (null, "Bu e-posta adresi zaten kayitli");
                }
                var user = new AppUser
                {
                    DisplayName = displayName,
                    Email = email,
                    CreateAt = DateTime.UtcNow,
                    LastSeenAt = DateTime.UtcNow,
                };
                user.PasswordHash = _passwordHasher.HashPassword(user, password);
                _data.Users.Add(user);
                await SaveInternalAsync();
                return (user, null);
            }
            finally
            {
                _gate.Release();
            }

        }

        public async Task<AppUser?> FindUserByEmailAsync(string email)
        {
            email = NormalizeEmail(email);
            await _gate.WaitAsync();
            try
            {
                return _data.Users.FirstOrDefault(user => string.Equals(user.Email, email, StringComparison.OrdinalIgnoreCase));
            }
            finally
            {
                _gate.Release();
            }
        }
        public async Task<AppUser?> GetUserAsync(Guid userId)
        {
            await _gate.WaitAsync();
            try
            {
                return _data.Users.FirstOrDefault(user => user.Id == userId);
            }
            finally
            {
                _gate.Release();
            }
        }

        public async Task<IReadOnlyList<UserDto>> GetUsersAsync(Guid curentUserId)
        {
            await _gate.WaitAsync();
            try
            {
                return _data.Users
                    .Where(user => user.Id != curentUserId)
                    .OrderBy(user => user.DisplayName)
                    .Select(user => ToUserDto(user))
                    .ToList();
            }
            finally
            {
                _gate.Release();
            }
        }
        public async Task<IReadOnlyList<ConversationSummaryDto>> GetConversationSummaryAsync(Guid curentUserId)
        {
            await _gate.WaitAsync();
            try
            {
                return _data.Conversations
                    .Where(conversation => conversation.ParticipantIds.Contains(curentUserId))
                    .Select(conversation => BuildConversationSummary(conversation, curentUserId))
                    .Where(summary => summary is not null)
                    .Select(summary => summary!)
                    .OrderByDescending(summary => summary.UpdateAt)
                    .ToList();
            }
            finally { _gate.Release(); }
        }
        public async Task<(ConversationCreatedDto? Conversation, string? Error)>
            GetOrCreatePrivateConversationAsync(
            Guid currentUserId,
            Guid otherUserId)
        {
            await _gate.WaitAsync();
            try
            {
                if (currentUserId == otherUserId)
                {
                    return (null, "Bu kadar mi yanlizsin gercekten");
                }
                var otherUser = _data.Users.FirstOrDefault(user => user.Id == otherUserId);
                if (otherUser is null)
                {
                    return (null, "O kim ya Oyle biri yok");
                }
                var conversation = _data.Conversations.FirstOrDefault(item =>
                    item.ParticipantIds.Count == 2 &&
                    item.ParticipantIds.Contains(currentUserId) &&
                    item.ParticipantIds.Contains(otherUserId));
                if (conversation is null)
                {
                    conversation = new Conversation
                    {
                        ParticipantIds = [currentUserId, otherUserId],
                        CreateAt = DateTime.UtcNow,
                    };
                    _data.Conversations.Add(conversation);
                    await SaveInternalAsync();
                }
                return (
                    new ConversationCreatedDto(
                        conversation.Id,
                        ToUserDto(otherUser)),
                     null);
            }
            finally
            {
                _gate.Release();
            }
        }

        public async Task<IReadOnlyList<MessageDto>?> GetMessagesAsync(Guid curentUserId, Guid conversatinId, int take)
        {
            take = Math.Clamp(take, 1, 200);
            await _gate.WaitAsync();
            try
            {
                var conversation = _data.Conversations.FirstOrDefault(item => item.Id == conversatinId && item.ParticipantIds.Contains(curentUserId));
                if (conversation == null)
                {
                    return null;
                }
                return _data.Messages
                    .Where(message => message.ConversationId == conversatinId)
                    .Where(message => !message.DeletedForUserIds.Contains(curentUserId))
                    .OrderByDescending(message => message.SentAt)
                    .Take(take)
                    .OrderBy(message => message.SentAt)
                    .Select(ToMessageDto)
                    .ToList();
            }

        public async Task<MessageDto?> EditMessageAsync(Guid messageId, Guid userId, string content)
        {
            await _gate.WaitAsync();
            try
            {
                var message = _data.Messages.FirstOrDefault(item => item.Id == messageId && item.SenderId == userId && !item.IsDeleted);
                if (message is null || string.IsNullOrWhiteSpace(content)) return null;
                message.Content = content.Trim();
                message.EditedAt = DateTime.UtcNow;
                await SaveInternalAsync();
                return ToMessageDto(message);
            }
            finally { _gate.Release(); }
        }

        public async Task<MessageDto?> DeleteMessageAsync(Guid messageId, Guid userId, bool forEveryone)
        {
            await _gate.WaitAsync();
            try
            {
                var message = _data.Messages.FirstOrDefault(item => item.Id == messageId && item.SenderId == userId);
                if (message is null) return null;
                if (forEveryone)
                {
                    message.Content = "Bu mesaj silindi";
                    message.IsDeleted = true;
                }
                else if (!message.DeletedForUserIds.Contains(userId))
                {
                    message.DeletedForUserIds.Add(userId);
                }
                await SaveInternalAsync();
                return ToMessageDto(message);
            }
            finally { _gate.Release(); }
        }
            finally
            {
                _gate.Release();
            }
        }
