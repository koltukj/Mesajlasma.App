        public async Task<bool?> MarkConversationReadAsync(
            Guid conversationId,
            Guid currentUserId)
        {
            await _gate.WaitAsync();
            try
            {
                var conversation = _data.Conversations.FirstOrDefault(item =>
                    item.Id == conversationId &&
                    item.ParticipantIds.Contains(currentUserId));
                if (conversation == null)
                {
                    return null;
                }
                var changed = false;
                foreach (var message in _data.Messages.Where(message =>
                message.ConversationId == conversationId &&
                message.SenderId != currentUserId))
                {
                    if (!message.ReadByUserIds.Contains(currentUserId))
                    {
                        message.ReadByUserIds.Add(currentUserId);
                        changed = true;
                    }
                }
                if (changed)
                {
                    await SaveInternalAsync();
                }
                return changed;
            }
            finally
            {
                _gate.Release();
            }
        }

